# Server
PORT=5000
NODE_ENV=development

# Frontend
CLIENT_URL=http://localhost:5173

# MongoDB - replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/laxmi_construction?retryWrites=true&w=majority

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Admin seed/login
ADMIN_NAME=Laxmi Construction Admin
ADMIN_EMAIL=admin@laxmiconstruction.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Optional email configuration for password reset/contact notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Laxmi Construction <no-reply@laxmiconstruction.com>

# Optional AI provider
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
